# Coupon Sentinel - Backend Environment Variables
#
# Copy to .env for local development (python-dotenv loads it automatically).
# In production (Render), set these in the service's Environment tab —
# never commit real values.

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Defaults to a local SQLite file (./coupon_sentinel.db) if unset — fine for
# local dev/tests, not for production. Render Postgres gives you a
# postgres:// URL; the app rewrites that to postgresql:// automatically.
DATABASE_URL=

# Reserved for Milestone 2+ (price/session caching). Not read by the app yet.
REDIS_URL=

# ----------------------------------------------------------------------------
# Auth
# ----------------------------------------------------------------------------
# Required in production — falls back to a random per-process secret in dev,
# which invalidates tokens on every restart.
JWT_SECRET=

# ----------------------------------------------------------------------------
# Stripe (Milestone 1 scaffolding — Michael provides real keys)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe Dashboard for the Pro / Premium recurring prices.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# ----------------------------------------------------------------------------
# Kroger API (Milestone 2 — client implemented, unverified against the live
# API: no credentials exist for this project yet. Get them at
# https://developer.kroger.com. Powers GET /api/kroger/search and
# GET /api/kroger/products/{id}; unset, those return 503.)
# ----------------------------------------------------------------------------
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Override only for testing against a non-production Kroger environment.
KROGER_BASE_URL=

# ----------------------------------------------------------------------------
# Email verification (Milestone 4 — implemented, unverified against a real
# provider: no credentials exist for this project yet. Get a Resend key at
# https://resend.com — it's checked first; SendGrid is a fallback. Powers
# POST /api/auth/resend-verification; unset, that returns 503.)
# ----------------------------------------------------------------------------
RESEND_API_KEY=
SENDGRID_API_KEY=
# Sender address. Leave unset to use Resend's own onboarding@resend.dev
# default (works out of the box, but only for sending to your own Resend
# account's email — verify a real domain for production). If SendGrid is
# the active provider (RESEND_API_KEY unset), this MUST be set to a
# SendGrid-verified sender — Resend's address will not authenticate there
# and every send will fail; unset, /resend-verification returns 503 rather
# than silently trying.
EMAIL_FROM=

# Base URL the verification link points to (the frontend's /verify-email page).
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# Analytics & error tracking (Milestone 5 — implemented, unverified against
# real projects: no credentials exist for this project yet.
# - Analytics events (signup/login/optimize/subscribe/cancel_subscription)
#   always persist to the local analytics_events table regardless of this
#   section — MIXPANEL_TOKEN only adds best-effort forwarding on top.
# - SENTRY_DSN enables error tracking; unset, monitoring is a no-op (no
#   errors are silently dropped that wouldn't be anyway — this only adds
#   reporting, it doesn't change error handling).
# ----------------------------------------------------------------------------
MIXPANEL_TOKEN=
SENTRY_DSN=

# Frontend error tracking (Vite env — set in Vercel, not here). Unset, the
# frontend Sentry SDK is never initialized.
VITE_SENTRY_DSN=

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Coupon Sentinel - Frontend Environment Variables

# API URL (leave empty for development, Vite proxy handles it)
# In production, set to your backend URL
VITE_API_URL=

# Examples:
# VITE_API_URL=http://localhost:8000
# VITE_API_URL=https://coupon-sentinel-api.onrender.com

# Stripe publishable key (Milestone 4). Without it, the subscribe flow still
# creates the subscription on the backend but the payment-confirmation step
# (components/StripeCheckout.tsx) shows a "Stripe isn't configured" message
# instead of a card form — no real key exists for this project yet.
VITE_STRIPE_PUBLIC_KEY=
